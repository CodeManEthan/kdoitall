# Standard .desktop file locations
readonly DESKTOP_FILE_LOCATIONS=(
    "/usr/share/applications"
    "/usr/local/share/applications"
    "$HOME/.local/share/applications"
    "/var/lib/flatpak/exports/share/applications"
    "$HOME/.local/share/flatpak/exports/share/applications"
    "/var/lib/snapd/desktop/applications"
)

export DESKTOP_FILE_LOCATIONS

# Safe-mode prompting during workspace open
SAFE_MODE_PROMPTING="enabled"

# File logging (writes full verbose output to log file regardless of CLI flag)
LOG_TO_FILE="disabled"

# Log directory (only used when LOG_TO_FILE is enabled)
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kdoitall/logs"

# Timeout (seconds) per window during assisted close before auto-skipping
CLOSE_WAIT_TIMEOUT=60

export SAFE_MODE_PROMPTING LOG_TO_FILE LOG_DIR CLOSE_WAIT_TIMEOUT

# GPT-5 / OpenAI API integration (optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
AI_SCREENSHOT_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kdoitall/ai-screenshots"
AI_SCREENSHOT_CMD="kdotool window screenshot \"{uuid}\" \"{path}\""

export OPENAI_API_KEY OPENAI_MODEL AI_SCREENSHOT_DIR AI_SCREENSHOT_CMD
