# along with this program.  If not, see <https://www.gnu.org/licenses/>.

set -euo pipefail

# Determine paths (resolve symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
# Resolve symlink if necessary
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    # If readlink returned relative path, make it absolute
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export LIB_DIR="${SCRIPT_DIR}/../lib"
export KDOITALL_ROOT="${SCRIPT_DIR}/.."

readonly LIB_DIR KDOITALL_ROOT

# ============================================================================
# Set up file descriptor 3 for display output
# ============================================================================
# fd 3 is used throughout kdoitall for user-facing display output
exec 3>&1

# ============================================================================
# LAYER 1 - Foundation (no dependencies)
# ============================================================================
# shellcheck source=../lib/core/error-codes.sh
source "${LIB_DIR}/core/error-codes.sh"
# shellcheck source=../lib/utils/debug.sh
source "${LIB_DIR}/utils/debug.sh"

# ============================================================================
# Command Parsing
# ============================================================================

COMMAND=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose|--info)
            # Already handled by debug.sh, just skip
            shift
            ;;
        *)
            # This is the actual command
            COMMAND="$1"
            shift
            break
            ;;
    esac
done

# ============================================================================
# LAYER 2 - Core Utilities (depend only on foundation)
# ============================================================================
# shellcheck source=../config
source "${KDOITALL_ROOT}/config"
# shellcheck source=../lib/core/common.sh
source "${LIB_DIR}/core/common.sh"

# Source user config overrides (if exists)
if [[ -f "$KDOITALL_CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$KDOITALL_CONFIG"
fi

# Initialize file logging (depends on LOG_TO_FILE and LOG_DIR from config)
init_file_logging

# shellcheck source=../lib/utils/checks.sh
source "${LIB_DIR}/utils/checks.sh"
# shellcheck source=../lib/utils/validators.sh
source "${LIB_DIR}/utils/validators.sh"

# ============================================================================
# LAYER 3 - Core Services (depend on foundation + core utilities)
# ============================================================================
# shellcheck source=../lib/core/database.sh
source "${LIB_DIR}/core/database.sh"
# shellcheck source=../lib/core/ydotool.sh
source "${LIB_DIR}/core/ydotool.sh"

# Set up Ctrl+C handler
cleanup_on_exit() {
    local exit_code=$?
    if [[ $exit_code -eq 130 ]]; then  # 130 = interrupted by Ctrl+C
        echo ""
        echo "⚠️  Operation interrupted by user"
    fi
    
    # Kill background jobs
    jobs -p | xargs -r kill 2>/dev/null
    
    exit $exit_code
}

trap cleanup_on_exit SIGINT SIGTERM EXIT

# ============================================================================
# LAYER 4 - Screen and Desktop Detection (depends on core services)
# ============================================================================
# shellcheck source=../lib/core/screen-detection.sh
source "${LIB_DIR}/core/screen-detection.sh"

# Detect screen configuration on startup
if ! detect_screens; then
    echo "ERROR: Failed to detect screen configuration" >&2
    echo "Make sure kscreen-doctor is available and screens are configured" >&2
    exit 1
fi

# Detect desktop configuration on startup
if ! detect_desktops; then
    echo "ERROR: Failed to detect desktop configuration" >&2
    echo "Make sure kdotool is available and virtual desktops are configured" >&2
    exit 1
fi

# Optionally log detected screens and desktops in verbose mode
if [[ "${VERBOSE_MODE:-false}" == "true" ]]; then
    list_detected_screens
    echo ""
    echo "Detected Desktops: $DETECTED_DESKTOP_COUNT"
fi
# ============================================================================
# Dependency Check
# ============================================================================
check_dependencies

# ============================================================================
# Command Dispatch
# ============================================================================
case "$COMMAND" in
    --help|-h)
        # shellcheck source=../lib/commands/help.sh
        source "${LIB_DIR}/commands/help.sh"
        show_help
        ;;
    
    --version|-v)
        echo "kdoitall v$(cat "${KDOITALL_ROOT}/VERSION")"
        ;;
        
    workspace)
        # shellcheck source=../lib/commands/workspace/dispatcher.sh
        source "${LIB_DIR}/commands/workspace/dispatcher.sh"
        workspace_command "$@"
        ;;

    app)
        # shellcheck source=../lib/commands/app/dispatcher.sh
        source "${LIB_DIR}/commands/app/dispatcher.sh"
        app_command "$@"
        ;;

    screen)
        # shellcheck source=../lib/commands/screen/dispatcher.sh
        source "${LIB_DIR}/commands/screen/dispatcher.sh"
        screen_command "$@"
        ;;

    window)
        # shellcheck source=../lib/commands/window/dispatcher.sh
        source "${LIB_DIR}/commands/window/dispatcher.sh"
        window_command "$@"
        ;;

    status)
        # shellcheck source=../lib/commands/status.sh
        source "${LIB_DIR}/commands/status.sh"
        status_command
        ;;

    update)
        # shellcheck source=../lib/commands/update.sh
        source "${LIB_DIR}/commands/update.sh"
        update_command
        ;;

    *)
        echo "Error: Unknown command: $COMMAND" >&2
        echo "Run 'kdoitall --help' for usage information" >&2
        exit 1
        ;;
esac