{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kdoitall Application Metadata",
  "description": "Metadata schema for kdoitall application definitions",
  "type": "object",
  "required": ["terminal_command", "launch_options"],
  "properties": {
    "terminal_command": {
      "type": "string",
      "description": "Command to validate terminal availability"
    },
    "launch_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["function_name", "description"],
        "properties": {
          "function_name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$",
            "description": "Bash function name (must exist in functions.sh)"
          },
          "description": {
            "type": "string",
            "description": "User-friendly description of what this launch option does"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][a-zA-Z0-9_]*$",
                  "description": "Simple descriptive parameter name (e.g., 'Path', 'Workspace', 'Directory')"
                },
                "description": {
                  "type": "string",
                  "description": "User-friendly parameter description"
                }
              }
            }
          }
        }
      }
    }
  }
}